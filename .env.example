# =============================================================================
# FunPay Cardinal & Carnaval Environment Variables Template
# Скопируйте этот файл в .env или укажите переменные в настройках хостинга (Infrlo/Docker)
# НЕ коммитьте файл с реальными значениями в Git!
# =============================================================================

# --- FunPay ---
FUNPAY_GOLDEN_KEY=
FUNPAY_USER_AGENT=
FUNPAY_PROXY=
LOCALE=ru

# --- Telegram Bot ---
TG_BOT_TOKEN=
TG_PANEL_PASSWORD=

# --- Carnaval Server & Mini App ---
CARNAVAL_ENABLED=1
CARNAVAL_HOST=0.0.0.0
CARNAVAL_PORT=5000
PORT=5000
CARNAVAL_SECRET=
CARNAVAL_ALLOWED_ORIGINS=https://your-carnaval.vercel.app
CARNAVAL_PUBLIC_URL=https://your-carnaval.vercel.app

# --- Безопасность и проксирование ---
CARNAVAL_TRUST_PROXY=1
CARNAVAL_ALLOW_ANY_ORIGIN=0
